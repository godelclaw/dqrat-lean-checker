        (mkLit on_ (!(σSeed on_))) (mkLit of_ posSeed) ∧
      PatchPoolCandidate s vars on_ (σSeed on_) sk
        (patchDeleteWitnessAt s.formula of_ σSeed sk) ∧
      (PatchPoolBlockedPathBranch s vars on_ (σSeed on_) sk
          (patchDeleteWitnessAt s.formula of_ σSeed sk) ∨
        (∃ σ flipVar,
          flipVar ∈ vars.toList ∧
