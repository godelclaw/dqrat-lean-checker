            Pure.pure] using congrFun (hbody internalExi) s
    · have hmissing : s.formula.externalVarExists extExi = false := by
        cases hval : s.formula.externalVarExists extExi <;> simp_all
      cases hrun : addVarExists extExi #[] s with
      | error e s' =>
