      have hloop := checkAddUniversalLoop_correct_spec dqbf cs lineNum extVars s hcorr
      simp only [WP.wp, PredTrans.apply, EStateM.run] at hloop
      rw [hloop_run] at hloop
      exact hloop.elim
  | ok r s' =>
