              ⟨σSeed on_, skStop, σStop, flipVarStop, hpoolStop,
                hnotMemStop, hwitStop, hexiStop, hcontainsStop,
                hnoPathStop⟩)
      · rcases hexternal with
          ⟨σ, flipVar, hnotMem, hwit, hexi_flip, hcontains_flip,
            hnoPath⟩
