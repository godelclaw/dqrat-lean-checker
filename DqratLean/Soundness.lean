    ∃ σSeed posSeed,
      DeleteDepWitness s.formula of_ on_ sk σSeed ∧
      s.formula.litValue σSeed sk (mkLit of_ posSeed) = true ∧
      s.formula.litValue (flipUniv on_ σSeed) sk
        (mkLit of_ (!posSeed)) = true ∧
