    (hlt : target.x < reach.size) :
    (getReachable.go st lvar negL (worklist.push prev.negate) reach expl).getD
      target.x false = true := by
  rcases getClauseRaw_deleted_of_getClause hget with ⟨hraw, hdel⟩
