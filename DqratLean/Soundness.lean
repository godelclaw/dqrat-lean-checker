      have hshape := checkAddUniversalLoop_shape_spec lineNum extVars s trivial
      simp only [WP.wp, PredTrans.apply, EStateM.run] at hloop hshape
      rw [hloop_run] at hloop hshape
      cases hres : r.fst with
