  funext s
  by_cases hzero : extExi = 0
  · simp [checkModifyExistential, checkModifyExistentialNoNegProof, hzero]
  · have hget_formula :
        (((fun x => x.formula) <$> (get : CheckM CheckState)) s) = .ok s.formula s := by
